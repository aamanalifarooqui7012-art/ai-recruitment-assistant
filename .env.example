# Copy this file to `.env` (same folder) and paste your own key. NEVER commit `.env`.
# Phase 1 + Phase 2 use this Groq key:
GROQ_API_KEY=paste_your_groq_key_here
# Phase 3A + 3B use this SECOND Groq key (create it in a different Groq account, so the rate limits are separate):
GROQ_API_KEY_2=paste_your_second_groq_key_here
# optional, Phase 3B only (default openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
